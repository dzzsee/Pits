{
  "name": "@pits/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:dump": "tsx scripts/dump-db.ts",
    "db:dump:fresh": "tsx scripts/make-dump.ts",
    "db:rehash": "tsx scripts/rehash-seed.ts",
    "db:reseed": "tsx scripts/reseed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "smoke": "tsx scripts/smoke.ts",
    "sweep": "tsx scripts/sweep.ts",
    "deploy": "wrangler deploy",
    "deploy:d1": "npm run db:prepare-d1 -w @pits/api && npm run deploy:d1:upload -w @pits/api",
    "db:prepare-d1": "tsx scripts/d1-seed.ts",
    "deploy:d1:upload": "wrangler d1 execute pits-db --remote --file=../../.wrangler/d1-seed.sql"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.149.0"
  }
}
