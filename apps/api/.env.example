# Puerto del API
PORT=3001

# Origenes permitidos (CORS), separados por coma
CORS_ORIGIN=http://localhost:5173

# Secretos (cambiar en produccion)
JWT_SECRET=cambia-este-secret-en-produccion
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Base de datos (ruta relativa a apps/api)
DATABASE_PATH=./data/pits.db

# Datos del taller
SHOP_NAME=Pits
SHOP_CURRENCY=USD

# Credenciales del admin que crea el seed
SEED_ADMIN_EMAIL=admin@pits.local
SEED_ADMIN_PASSWORD=admin1234

# VAPID (generar con: npx web-push generate-vapid-keys)
# Si se dejan vacias, las notificaciones push quedan deshabilitadas
# y la app solo muestra notificaciones in-app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pits.local
